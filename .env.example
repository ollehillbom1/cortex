# Cortex runtime configuration.
# Cortex is local-first: no external services, API keys or secrets are required.
# These variables only tune how the HTTP server itself runs.

# Port the Next.js server listens on (default: 3000).
PORT=3000

# Host interface to bind (default: 0.0.0.0 inside Docker).
HOSTNAME=0.0.0.0

# --- Optional AI phrasing of insights (issue #11, off unless set) -----------
# Point these at a language-model endpoint YOU run (Ollama, llama.cpp, LM
# Studio, vLLM — anything OpenAI-compatible). Leave them unset and the feature
# does not exist: no setting is shown and the endpoint refuses all requests.
# Only structured facts (numbers and fixed enums) are ever sent — never names.
# See docs/adr/0008-optional-coach.md.
# COACH_API_BASE=http://127.0.0.1:11434/v1
# COACH_MODEL=llama3.2
# Only needed if your endpoint requires a bearer token. Never commit a real key.
# COACH_API_KEY=

# Where the sync endpoint stores end-to-end-encrypted blobs for households
# that enable device sync (default: ./data locally, /app/data in Docker).
# The server cannot read these blobs — they are AES-GCM encrypted with a key
# derived from the household's passphrase, which never leaves the browser.
SYNC_DATA_DIR=./data
